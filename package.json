{
  "name": "open-website-builder",
  "version": "0.1.14",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loic294/open-website-builder.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./vite.config.js": "./vite.config.js",
    "./site-config.js": "./src/site-config.js",
    "./plugins/owb-backend-plugin.js": "./src/plugins/owb-backend-plugin.js",
    "./plugins/owb-image-plugin.js": "./src/plugins/owb-image-plugin.js",
    "./providers/filesystem-backend-providers.js": "./server/providers/filesystem-backend-providers.js",
    "./providers/in-memory-backend-providers.js": "./server/providers/in-memory-backend-providers.js",
    "./providers/sqlite-backend-providers.js": "./server/providers/sqlite-backend-providers.js",
    "./database/sqlite-database.js": "./server/database/sqlite-database.js",
    "./data/data-api-provider.js": "./server/data/data-api-provider.js",
    "./styles/base.css": "./src/website/styles/base.css",
    "./styles/theme.css": "./src/website/styles/theme.css",
    "./published.js": "./dist-pub/published.js",
    "./publish/publish-provider.js": "./server/publish/publish-provider.js",
    "./publish/sqlite-publish-provider.js": "./server/publish/sqlite-publish-provider.js",
    "./server/files/sync-from-r2.js": "./server/files/sync-from-r2.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.html",
    "editor/",
    "package.json",
    "vite.config.js",
    "vite.pub.config.js",
    "dist-pub/",
    "src/",
    "server/"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "build:pub": "vite build --config vite.pub.config.js",
    "prepack": "npm run build:pub",
    "test:publish": "node --test ./server/publish/*.test.js",
    "test:server": "node --test ./server/**/*.test.js",
    "check:urls": "node ./server/data/check-canonical-urls.js",
    "preview": "vite preview",
    "generate": "npm run build:pub && node ./server/publish/publish-cli.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lit-labs/ssr": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.23.5",
    "@tiptap/extension-bubble-menu": "^3.23.5",
    "@tiptap/extension-link": "^3.23.5",
    "@tiptap/extension-text-align": "^3.23.5",
    "@tiptap/extension-text-style": "^3.23.5",
    "@tiptap/extension-underline": "^3.23.5",
    "@tiptap/pm": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "altcha": "^3.0.10",
    "aws4": "^1.13.2",
    "busboy": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "daisyui": "^5.7.9",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.8.0",
    "lit": "^3.1.0",
    "lucide": "^1.16.0",
    "sharp": "^0.35.3",
    "simple-icons": "^16.20.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "vite": "^5.0.0",
    "vitepress": "^2.0.0-alpha.18"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,json,md,css,html,yml,yaml}": "prettier --write"
  }
}
